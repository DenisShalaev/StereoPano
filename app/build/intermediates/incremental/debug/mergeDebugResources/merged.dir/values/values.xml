    <string name="set_ae_d">Lock exposure and white balance while recording (fewer brightness jumps).</string>
    <string name="set_ae_t">Lock exposure</string>
    <string name="set_all_d">Also lists every .vr.jpg on the device (e.g. from Cardboard Camera or older Pixel phones). Needs permission to read photos.</string>
    <string name="set_all_t">Show panoramas of other apps</string>
    <string name="set_angle_d">Distance of the image strips from the image centre. Larger = stronger 3D effect (stereo base ≈ 2 × arm length × sin). Default 3.5°.</string>
    <string name="set_angle_t">Stereo angle</string>
    <string name="set_audio_d">Also record ambient sound (stored in the .vr.jpg).</string>
    <string name="set_audio_t">Record sound</string>
    <string name="set_author_d">Stored in every new panorama (searchable in galleries and Google Photos). Leave empty to store no name. Inserts the e-mail address of the chosen Google account.</string>
    <string name="set_author_t">Author name</string>
    <string name="set_compass_d">Align the panorama to real compass directions (if stored in the image).</string>
    <string name="set_compass_t">Compass</string>
    <string name="set_delta_d">Width of the soft transition between camera frames. Larger = fewer seams but slightly softer. Default 0.6°.</string>
    <string name="set_delta_t">Blend window</string>
    <string name="set_focal_d">Corrects the computed field of view. If objects look stretched or squeezed in the panorama or the guides drift, adjust here. Default 100.</string>
    <string name="set_focal_t">Focal length correction</string>
    <string name="set_gacc_d">Tap to choose. Needs internet and a one-time permission dialog.</string>
    <string name="set_gacc_t">Google account for Photos</string>
    <string name="set_guides_d">Crosshair, horizon and pace dot over the camera image.</string>
    <string name="set_guides_t">Show guides</string>
    <string name="set_gyro_d">The view follows the movements of the phone.</string>
    <string name="set_gyro_t">Gyroscope</string>
    <string name="set_half_d">Each eye squeezed horizontally – for glasses that stretch the image back.</string>
    <string name="set_half_t">Half side-by-side (glasses)</string>
    <string name="set_k1_d">Distortion strength near the centre. Default 0.34.</string>
    <string name="set_k1_t">Lens coefficient k1</string>
    <string name="set_k2_d">Distortion strength at the edge. Default 0.55.</string>
    <string name="set_k2_t">Lens coefficient k2</string>
    <string name="set_latency_d">Time offset between camera frame and rotation sensor. If vertical lines show double edges or zigzags, adjust in small steps.</string>
    <string name="set_latency_t">Sensor latency</string>
    <string name="set_lens_d">Barrel pre-distortion for Cardboard lenses.</string>
    <string name="set_lens_t">Lens correction (Cardboard)</string>
    <string name="set_loc_d">Writes GPS position and place names (city, region) into the file as tags and EXIF. Turn off if you share panoramas publicly and do not want your position stored.</string>
    <string name="set_loc_t">Save location</string>
    <string name="set_move_d">Detects people and other moving objects while you turn and fills the gaps with the background seen at another moment. Higher = more sensitive. Works best on textured objects; plain-coloured objects may be only partly removed. Uses about 50 MB extra memory and some processing. 0 = off. Experimental. Default 0 (off).</string>
    <string name="set_move_t">Moving objects</string>
    <string name="set_quality_d">Quality of the saved panoramas. Default 90.</string>
    <string name="set_quality_t">JPEG quality</string>
    <string name="set_res_d">Long side of the captured frames. Higher = sharper but needs a lot of memory (applies when you return to the camera).</string>
    <string name="set_res_t">Camera resolution</string>
    <string name="set_sbsfov_d">Vertical field of view in glasses mode. Default 45°.</string>
    <string name="set_sbsfov_t">Glasses field of view</string>
    <string name="set_sharp_d">Light sharpening of the finished panorama (brightness only, no colour fringes). Compensates the softness that comes from combining many frames. 0 = off. Default 50.</string>
    <string name="set_sharp_t">Sharpening</string>
    <string name="set_stab_d">Frames recorded while the phone tilts up/down or sideways faster than this count less (they are never discarded, so no gaps appear). Lower = straighter horizons and fewer steps on horizontal edges, but a steadier hand helps. Maximum = off. Default 6°/s.</string>
    <string name="set_stab_t">Motion filter</string>
    <string name="set_target_d">Phone, phone + Google Photos, or Google Photos only (the phone copy is deleted only after a successful upload).</string>
    <string name="set_target_t">Save panoramas to</string>
    <string name="set_tempo_d">Speed of the red guide dot. 8°/s ≈ 45 s per revolution.</string>
    <string name="set_tempo_t">Target pace</string>
    <string name="set_wcorr_d">The rotation sensor under-reports the turn (on this phone about 4.5 %). Raise it if the end of the panorama overlaps the start; lower it if a gap remains.</string>
    <string name="set_wcorr_t">Angle correction</string>
