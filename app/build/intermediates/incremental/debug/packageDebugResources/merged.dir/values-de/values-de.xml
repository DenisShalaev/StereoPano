    <string name="set_ae_d">Belichtung und Weißabgleich während der Aufnahme sperren (weniger Helligkeitssprünge).</string>
    <string name="set_ae_t">Belichtung fixieren</string>
    <string name="set_angle_d">Abstand der Bildstreifen zur Bildmitte. Größer = stärkerer 3D-Effekt (Stereobasis ≈ 2 × Armlänge × sin). Standard 3,5°.</string>
    <string name="set_angle_t">Stereo-Winkel</string>
    <string name="set_audio_d">Umgebungston mit aufzeichnen (wird im .vr.jpg gespeichert).</string>
    <string name="set_audio_t">Ton aufnehmen</string>
    <string name="set_compass_d">Panorama nach Himmelsrichtungen ausrichten (falls im Bild gespeichert).</string>
    <string name="set_compass_t">Kompass</string>
    <string name="set_delta_d">Breite des weichen Übergangs zwischen Kamerabildern. Größer = weniger Nähte, aber leicht unschärfer. Standard 0,6°.</string>
    <string name="set_delta_t">Mittelungsfenster</string>
    <string name="set_focal_d">Korrigiert das berechnete Sichtfeld. Dehnen oder Stauchen sich Objekte im Panorama oder wandern die Leitpunkte, hier nachstellen. Standard 100.</string>
    <string name="set_focal_t">Brennweiten-Korrektur</string>
    <string name="set_guides_d">Fadenkreuz, Horizont und Tempo-Punkt über dem Kamerabild.</string>
    <string name="set_guides_t">Leitpunkte anzeigen</string>
    <string name="set_gyro_d">Die Ansicht folgt den Bewegungen des Telefons.</string>
    <string name="set_gyro_t">Gyroskop</string>
    <string name="set_half_d">Jedes Auge horizontal gestaucht – für Brillen, die das Bild wieder strecken.</string>
    <string name="set_half_t">Half-SBS (Brille)</string>
    <string name="set_k1_d">Stärke der Verzerrung im Mittelbereich. Standard 0,34.</string>
    <string name="set_k1_t">Linsen-Koeffizient k1</string>
    <string name="set_k2_d">Stärke der Verzerrung am Rand. Standard 0,55.</string>
    <string name="set_k2_t">Linsen-Koeffizient k2</string>
    <string name="set_latency_d">Zeitversatz zwischen Kamerabild und Drehsensor. Bei Doppelkanten oder Zacken an senkrechten Linien in kleinen Schritten anpassen.</string>
    <string name="set_latency_t">Sensor-Latenz</string>
    <string name="set_lens_d">Tonnenförmige Vorverzerrung für Cardboard-Linsen.</string>
    <string name="set_lens_t">Linsenkorrektur (Cardboard)</string>
    <string name="set_move_d">Erkennt Personen und andere bewegte Objekte während des Drehens und füllt die Lücken mit dem Hintergrund aus einem anderen Moment. Höher = empfindlicher. Funktioniert am besten bei strukturierten Objekten; einfarbige Objekte werden evtl. nur teilweise entfernt. Braucht ca. 50 MB zusätzlichen Speicher und etwas Rechenzeit. 0 = aus. Experimentell. Standard 0 (aus).</string>
    <string name="set_move_t">Bewegte Objekte</string>
    <string name="set_quality_d">Qualität der gespeicherten Panoramen. Standard 90.</string>
    <string name="set_quality_t">JPEG-Qualität</string>
    <string name="set_res_d">Lange Bildseite der Aufnahme. Höher = schärfer, braucht aber viel Speicher (wirkt nach der Rückkehr zur Kamera).</string>
    <string name="set_res_t">Kameraauflösung</string>
    <string name="set_sbsfov_d">Vertikales Sichtfeld im Brillenmodus. Standard 45°.</string>
    <string name="set_sbsfov_t">Sichtfeld SBS-Brille</string>
    <string name="set_sharp_d">Leichte Nachschärfung des fertigen Panoramas (nur Helligkeit, keine Farbsäume). Gleicht die Weichheit durch das Zusammensetzen vieler Bilder aus. 0 = aus. Standard 50.</string>
    <string name="set_sharp_t">Nachschärfung</string>
    <string name="set_stab_d">Bilder, die aufgenommen werden, während das Telefon schneller als dieser Wert nickt oder kippt, zählen weniger (sie werden nie verworfen, daher entstehen keine Lücken). Niedriger = geradere Horizonte und weniger Treppen an waagerechten Kanten, aber eine ruhigere Hand hilft. Maximum = aus. Standard 6°/s.</string>
    <string name="set_stab_t">Bewegungsfilter</string>
    <string name="set_tempo_d">Geschwindigkeit des roten Leitpunkts. 8°/s ≈ 45 s pro Umdrehung.</string>
    <string name="set_tempo_t">Ziel-Tempo</string>
